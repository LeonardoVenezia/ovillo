# Copiar a .env.local y completar. `.env*` está en .gitignore.

# --- Base de datos (Neon) — Fase 1 ---
# Crear un proyecto gratis en https://neon.com y pegar acá la connection string
# (Neon dashboard → Connect → "Connection string"). Para desarrollo conviene
# una rama de Neon aparte (la usan también los tests e2e).
DATABASE_URL=postgresql://usuario:password@ep-xxx.region.aws.neon.tech/ovillo?sslmode=require

# --- URL pública del sitio (opcional en desarrollo) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Fase 2: autenticación (Better Auth) ---
# BETTER_AUTH_SECRET=          # cadena aleatoria de 32+ caracteres
# BETTER_AUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=            # Google Cloud Console → OAuth client
# GOOGLE_CLIENT_SECRET=

# --- Fase 2: email transaccional (Resend) ---
# RESEND_API_KEY=
# EMAIL_FROM="Ovillo <hola@tudominio.com>"

# --- Fase 2: imágenes (Cloudflare R2) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
