# Copiar a .env.local y completar. `.env*` está en .gitignore.

# --- Base de datos (Neon) — Fase 1 ---
# Crear un proyecto gratis en https://neon.com y pegar acá la connection string
# (Neon dashboard → Connect → "Connection string"). Para desarrollo conviene
# una rama de Neon aparte (la usan también los tests e2e).
DATABASE_URL=postgresql://usuario:password@ep-xxx.region.aws.neon.tech/ovillo?sslmode=require

# --- URL pública del sitio (opcional en desarrollo) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Fase 2: autenticación (Better Auth) — requeridas ---
# BETTER_AUTH_SECRET: generar con `openssl rand -base64 32` (32+ caracteres).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth queda para más adelante (se acordó empezar con email + contraseña).
# Cuando toque: Google Cloud Console → OAuth client.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Fase 2: email transaccional (Resend) ---
# Sin dominio verificado, Resend solo entrega a la casilla dueña de la cuenta
# (remitente "onboarding@resend.dev"). El dominio propio queda pendiente.
# RESEND_API_KEY=
# EMAIL_FROM="Ovillo <onboarding@resend.dev>"
# Bandeja de salida para los tests e2e (`pnpm test:e2e`): los emails se guardan
# acá en vez de enviarse. Lo configura playwright.config.ts; no usar en prod.
# EMAIL_OUTBOX_PATH=test-results/outbox.jsonl

# --- Fase 2: imágenes (Cloudflare R2) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
